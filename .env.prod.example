# Copy to .env on the server (same directory as docker-compose.prod.yml).
# Never commit the real file.

# --- Postgres ---
POSTGRES_USER=sorrel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sorrel
DATABASE_URL=postgres://sorrel:change-me@postgres:5432/sorrel

# --- RabbitMQ ---
RABBITMQ_USER=sorrel
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://sorrel:change-me@rabbitmq:5672

# --- Backend ---
PORT=8080
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=2592000000
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Must match `https://` + DOMAIN below if either ever changes — env files
# can't cross-reference other keys in the same file, so keep in sync by hand.
FRONTEND_URL=https://usesorrel.com
LOG_LEVEL=info
LOG_FORMAT=json

# --- Workers ---
HOMEPAGE_WORKER_CONCURRENCY=5
TECHNOLOGY_EVENT_WORKER_CONCURRENCY=5
CRAWL_BATCH_SIZE=100
CRAWL_STALE_AFTER_MS=604800000

# --- Traefik / TLS ---
# Public domain the app is served on — frontend at `/`, backend API at
# `/_api` on the same domain. Also used for the ACME (Let's Encrypt) cert.
DOMAIN=usesorrel.com
# Email Let's Encrypt sends cert expiry/revocation notices to.
ACME_EMAIL=marijus@usesorrel.com

# --- Deploy ---
# Overridden per-deploy by CI to the freshly built git-sha tag; defaults to
# :latest for manual `docker compose up` on the server.
BACKEND_IMAGE=ghcr.io/marijusar/sorrel-backend:latest
FRONTEND_IMAGE=ghcr.io/marijusar/sorrel-frontend:latest
