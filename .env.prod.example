# Copy to .env on the server (same directory as docker-compose.prod.yml).
# Never commit the real file.

# --- Postgres ---
POSTGRES_USER=hyva
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hyva
DATABASE_URL=postgres://hyva:change-me@postgres:5432/hyva

# --- RabbitMQ ---
RABBITMQ_USER=hyva
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://hyva:change-me@rabbitmq:5672

# --- Backend ---
PORT=8080
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=2592000000
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=json

# --- Workers ---
HOMEPAGE_WORKER_CONCURRENCY=5
TECHNOLOGY_EVENT_WORKER_CONCURRENCY=5
CRAWL_BATCH_SIZE=100
CRAWL_STALE_AFTER_MS=604800000

# --- Traefik access lock ---
# Your own IP (CIDR /32 appended by compose) — only this IP gets past the
# ipallowlist middleware.
ALLOWED_IP=203.0.113.10
# Basic-auth credentials come from ./traefik/htpasswd (not this file — avoids
# Compose's $ interpolation mangling a bcrypt hash). Generate it on the
# server with: htpasswd -cB traefik/htpasswd <username>

# --- Deploy ---
# Overridden per-deploy by CI to the freshly built git-sha tag; defaults to
# :latest for manual `docker compose up` on the server.
BACKEND_IMAGE=ghcr.io/marijusar/hyva-backend:latest
