{
  "name": "backend",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#migrations/*": "./migrations/*.ts"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput &) && node --watch --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/db/migrate.js",
    "sync:technologies": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/scripts/sync-technologies.js",
    "worker:homepage": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput &) && node --watch --env-file-if-exists=.env dist/workers/homepage-worker.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "hono": "^4.13.3",
    "impers": "0.1.0",
    "jose": "^6.2.9",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}